[
  {
    "label": "Preflight Check: Rust",
    "command": "cargo make check-all",
    "args": [
      "--manifest-path",
      "frigatebird/rust/Cargo.toml"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/",
    "use_new_terminal": true,
    "tags": [
      "preflight",
      "rust"
    ]
  },
  {
    "label": "Rust: FFI Fuzzing",
    "command": "cargo +nightly fuzz run ffi_boundary -- -max_total_time=60",
    "cwd": "$ZED_WORKTREE_ROOT/frigatebird/rust",
    "use_new_terminal": true
  },
  {
    "label": "Rust: AddressSanitizer",
    "command": "RUSTFLAGS='-Z sanitizer=address' cargo +nightly test",
    "cwd": "$ZED_WORKTREE_ROOT/frigatebird/rust",
    "use_new_terminal": true
  },
  {
    "label": "Rust: safer_ffi Migration Check",
    "command": "cargo +nightly expand --lib",
    "cwd": "$ZED_WORKTREE_ROOT/frigatebird/rust",
    "use_new_terminal": true
  },
  {
    "label": "Preflight Check: Dart/Flutter",
    "command": "bash",
    "args": [
      "-lc",
      "set -euo pipefail; cd $ZED_WORKTREE_ROOT/frigatebird; dart format --set-exit-if-changed .; dart analyze; dart test; cd $ZED_WORKTREE_ROOT/frigatedraw; dart format --set-exit-if-changed .; flutter analyze; flutter test; dcm analyze ."
    ],
    "cwd": "$ZED_WORKTREE_ROOT/",
    "use_new_terminal": true,
    "tags": [
      "preflight",
      "dart",
      "flutter"
    ]
  },
  {
    "label": "Preflight Check: Full Project",
    "command": "bash",
    "args": [
      "-lc",
      "set -euo pipefail; echo '=== Rust ===' && cd $ZED_WORKTREE_ROOT/frigatebird/rust && cargo fetch && cargo make check-all && echo '✓ Rust checks passed' && echo '=== Dart/Flutter ===' && cd $ZED_WORKTREE_ROOT/frigatebird && dart format --set-exit-if-changed . && dart analyze && dart test && cd $ZED_WORKTREE_ROOT/frigatedraw && dart format --set-exit-if-changed . && flutter analyze && flutter test && dcm analyze . && echo '✓ Dart/Flutter checks passed'"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/",
    "use_new_terminal": true,
    "tags": [
      "preflight"
    ]
  },
  {
    "label": "Flutter: Run",
    "command": "fvm",
    "args": [
      "flutter",
      "run"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/frigatedraw/example",
    "use_new_terminal": true,
    "tags": [
      "flutter"
    ]
  },
  {
    "label": "Dart: Test",
    "command": "dart",
    "args": [
      "test"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/frigatebird",
    "tags": [
      "dart-test"
    ]
  },
  {
    "label": "Flutter: Test",
    "command": "fvm",
    "args": [
      "flutter",
      "test"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/frigatedraw",
    "tags": [
      "flutter-test"
    ]
  },
  {
    "label": "Rust: Clippy",
    "command": "cargo",
    "args": [
      "clippy",
      "--all-targets",
      "--all-features",
      "--",
      "-D",
      "warnings"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/frigatebird/rust",
    "tags": [
      "rust-lint"
    ]
  },
  {
    "label": "Rust: Test",
    "command": "cargo",
    "args": [
      "test",
      "--all-features"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/frigatebird/rust",
    "tags": [
      "rust-test"
    ]
  },
  {
    "label": "DCM: Analyze All",
    "command": "dcm",
    "args": [
      "analyze",
      "."
    ],
    "tags": [
      "lint"
    ]
  },
  {
    "label": "Dart: Analyze",
    "command": "dart",
    "args": [
      "analyze"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/frigatebird",
    "tags": [
      "dart-lint"
    ]
  },
  {
    "label": "Flutter: Analyze",
    "command": "fvm",
    "args": [
      "flutter",
      "analyze"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/frigatedraw",
    "tags": [
      "flutter-lint"
    ]
  }
]
